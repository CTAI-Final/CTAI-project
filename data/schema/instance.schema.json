{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/CTAI-Final/CTAI-project/data/schema/instance.schema.json",
  "title": "CTAI delivery scenario",
  "description": "One multi-vehicle delivery scenario: a 20 x 20 km square, a depot at its centre, homogeneous vehicles and time-windowed customers.",
  "type": "object",
  "required": [
    "schema_version",
    "scenario_id",
    "depot",
    "customer_count",
    "vehicle_count",
    "vehicle_capacity_kg",
    "speed_km_per_min",
    "service_time_min",
    "customers"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of this schema.",
      "examples": ["1.0"]
    },
    "scenario_id": {
      "type": "string",
      "description": "Stable identifier, also used in result file names.",
      "minLength": 1
    },
    "depot": {
      "type": "object",
      "required": ["id", "x", "y"],
      "additionalProperties": false,
      "properties": {
        "id": { "const": 0, "description": "Fixed at 0." },
        "x": { "type": "number", "minimum": 0, "maximum": 20 },
        "y": { "type": "number", "minimum": 0, "maximum": 20 }
      }
    },
    "customer_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Must equal the length of the customers array."
    },
    "vehicle_count": { "type": "integer", "minimum": 1 },
    "vehicle_capacity_kg": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "100 kg in the course project."
    },
    "speed_km_per_min": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "0.5 km/min in the course project."
    },
    "service_time_min": {
      "type": "number",
      "minimum": 0,
      "description": "5 min in the course project."
    },
    "customers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/customer" }
    }
  },
  "definitions": {
    "customer": {
      "type": "object",
      "required": ["id", "x", "y", "demand_kg", "time_window_min"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "Customers are numbered 1..n without gaps."
        },
        "x": { "type": "number", "minimum": 0, "maximum": 20 },
        "y": { "type": "number", "minimum": 0, "maximum": 20 },
        "demand_kg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Not greater than vehicle_capacity_kg."
        },
        "time_window_min": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0 },
          "description": "Closed interval [earliest, latest] for the start of service. Early arrival waits; starting after latest is infeasible."
        }
      }
    }
  }
}
